---
/**
 * A page of `src/content/pages/`. Pillar: H1, folded answer block, the full calculator, then the body.
 * Guide and threshold page: H1, the answer block, its mini-simulator, then the body.
 * FAQ (shown and marked up from one list), related pages, sources and publisher box: PageLayout.
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Tool from './Tool.astro';
import { route, ROUTES } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById, statePageById } from '../lib/pages';
import { helpers, SOURCES } from '../lib/helpers';
import { groupInfo } from '../lib/topics';
import { stateRef } from '../data/states';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/page-types';
interface Props { page: PageDef }
const { page } = Astro.props;
const lang = 'en';
const ui = t(lang);
const path = route(page.id, lang);
const g = groupInfo(page.group);
const parts = page.body(helpers()).split(/<!--mini:([A-Za-z0-9_-]+)(?:\|([A-Za-z0-9+/=]+))?-->/);
const decode = (b?: string) => (b ? Buffer.from(b, 'base64').toString('utf8') : undefined);
const jsonLd = [articleSchema({ title: page.h1, description: page.description, path, lang }), webPageSchema({ name: page.h1, description: page.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: page.nav, path }])];
if (page.tool) jsonLd.push(webApplicationSchema({ name: page.h1, description: page.description, path, lang }));
if (page.faqs.length) jsonLd.push(faqSchema(page.faqs, lang));
const card = (id: string) => pageById(id)?.card ?? (statePageById(id) ? `SNAP, Medicaid, ACA, WIC and Section 8 figures for ${stateRef(id.slice(6)).name}` : '');
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id), description: card(id) }));
const sources = [...page.sources.map((k) => ({ name: SOURCES[k].label, url: SOURCES[k].url })), ...(page.extraSources ?? [])];
const methodHref = route('method', lang);
const toolHref = { food: 'snap-calculator', health: 'medicaid-income-limits', cash: 'eitc-calculator', housing: 'section-8-income-limits', poverty: 'federal-poverty-level' }[page.group];
const miniTarget = page.miniHref ?? toolHref;
const miniHref = ROUTES.some((r) => r.id === miniTarget) ? route(miniTarget, lang) : route('home', lang);
const kicker = page.kind === 'pillar' ? `${g.short} · every state` : page.kind === 'threshold' ? 'Poverty level · threshold' : `${g.short} · guide`;
---
<PageLayout title={page.title} description={page.description} lang={lang} jsonLd={jsonLd} faqs={page.faqs} related={related} sources={sources} breadcrumbs={[{ label: page.nav }]}>
  <article>
    <header class="mb-6">
      <p class="text-sm font-semibold uppercase tracking-wide text-accent-700">{kicker}</p>
      <h1 class="mt-1 font-serif text-3xl font-bold text-navy-900 md:text-4xl">{page.h1}</h1>
      <p class="mt-3 text-lg text-navy-700">{page.intro}</p>
      <p class="mt-3 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method')}</a></p>
    </header>
    {page.tool ? (
      <>
        <Clamp text={page.resume} lang={lang} id={`clamp-${page.id}`} class="mb-4" />
        <div data-outil class="mb-10"><Tool kind={page.tool} state={page.toolProps?.state} lock={page.toolProps?.lockState} size={page.toolProps?.size} income={page.toolProps?.income} idPrefix={page.id.slice(0, 6)} /></div>
      </>
    ) : (
      <>
        <p class="mb-6 text-navy-800">{page.resume}</p>
        {page.mini && <MiniSim client:load kind={page.mini} arg={page.miniArg === undefined ? undefined : JSON.stringify(page.miniArg)} href={miniHref} />}
      </>
    )}
    <div class="prose prose-slate max-w-none prose-headings:font-serif">
      {parts.map((p, i) => i % 3 === 0 ? <Fragment set:html={p ?? ''} /> : i % 3 === 1 ? <MiniSim client:load kind={p} arg={decode(parts[i + 1])} href={miniHref} /> : null)}
    </div>
  </article>
</PageLayout>
